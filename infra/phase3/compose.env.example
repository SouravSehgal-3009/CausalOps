# Copy to ignored compose.env on the approved VM and replace the placeholder
# with the reviewed, immutable OCI digest. This file may contain only comments,
# blank lines, and this one unquoted `KEY=value` assignment. Never use a mutable
# tag such as `latest`; record the digest in restricted-environment validation
# evidence.
CAUSALOPS_OLLAMA_IMAGE=registry.example.invalid/ollama@sha256:REPLACE_WITH_REVIEWED_DIGEST
