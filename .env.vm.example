# Environment for the host machine running the hosted API + replay worker
# (`causalops.api_runtime:app`) -- distinct from `.env.example`, which
# covers the local CLI only. Copy this to `.env.vm` (gitignored, never
# commit real values) on whatever machine will run `causalops-api` per
# infra/DEPLOYMENT.md. No `.env` loader exists; source it explicitly:
#   set -a; source .env.vm; set +a

# --- Shared with the CLI (see .env.example for the full explanation) ---
ENABLE_CLAUDE=true
LIVE_EVALUATION_MAX_USD=14

# --- Hosted-API-only ---

# Absolute path to this repo's checkout on this machine. app() refuses to
# start unless this directory actually contains pyproject.toml.
CAUSALOPS_PROJECT_ROOT=/absolute/path/to/CausalOps

# Comma-separated allowlist of Google account emails permitted to sign in
# -- must match terraform.tfvars's allowed_owners if you also deploy the
# Cloud Run API (both must agree, since owners might use either surface).
CAUSALOPS_ALLOWED_OWNERS=you@example.com

# The Web application OAuth 2.0 Client ID's id (see infra/DEPLOYMENT.md's
# OAuth section -- MUST be a "Web application" type client, not "Desktop";
# a Desktop-type client cannot power the dashboard's sign-in button and
# fails with a confusing "Error 401: invalid_client" that gives no hint
# why -- found live the hard way).
CAUSALOPS_GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# "sqlite" (default, omit this line) needs no GCP setup at all -- a
# single-process deployment, good for a first run. "firestore" requires
# infra/phase2's terraform applied first (google_firestore_database.default
# must exist) AND real GCP credentials on this machine (`gcloud auth
# application-default login`, or this machine's own attached service
# account if it's a GCE VM). Required if you also deploy the Cloud Run
# API -- Cloud Run has no local disk to share a sqlite file with this
# machine's worker, so both sides must agree on "firestore".
# CAUSALOPS_CONTROL_PLANE_BACKEND=firestore

# Marks this as the trusted worker host -- enables the MCP-dispatched
# hosted-worker path (spawns a real child process per investigation) and
# is a precondition for the Phase 4 Ollama/Qwen candidate gate (which
# also needs CAUSALOPS_CANDIDATE_EVALUATION=true, left unset here since
# that path is closed -- see README.md's "Non-goals").
CAUSALOPS_EXECUTION_ENV=vm

# Optional: only the owner-facing routes' local artifact bucket wiring --
# leave unset unless you've also applied the GCS bucket in terraform and
# want finalized reports durably copied there in addition to Firestore.
# CAUSALOPS_ARTIFACT_BUCKET=your-unique-bucket-name-causalops-artifacts
# CAUSALOPS_ARTIFACT_SERVICE_ACCOUNT=causalops-replay-control@your-gcp-project-id.iam.gserviceaccount.com

# Demo-only: makes the hosted API's pause/decide flow reliably reachable.
# lab_diagnosis.json (the default fixture) is scripted to always resolve
# cleanly and can never trigger PAUSED_APPROVAL under healthy conditions
# -- confirmed live. Leave unset for default behavior; set this to show
# the pause/approve/reject flow on demand.
# CAUSALOPS_REPLAY_FIXTURE=/absolute/path/to/CausalOps/src/causalops/replay_fixtures/hosted_escalation_demo.json

# Leave unset (defaults to running the real worker) on whichever single
# machine actually has Docker/lab access. If you deploy the Cloud Run API
# too, its own terraform-managed environment already sets this to
# "false" for you -- never set it here as well as there, or nothing runs
# the worker at all.
# CAUSALOPS_RUN_WORKER=true
