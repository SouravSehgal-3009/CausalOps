# These are the environment variables CausalOps reads. There is no `.env`
# loader in this project (no python-dotenv), so export them into your shell
# before running `causalops` -- e.g. `set -a; source .env; set +a`. Never
# commit real secrets.

# Required only for a live run (`causalops investigate --model claude`; see
# README.md). Absent or empty, causalops runs entirely on replay fixtures
# and the local synthetic lab; `causalops doctor` warns but does not fail
# if this is unset, since a replay run never needs it.
ANTHROPIC_API_KEY=

# This file is documentation only -- it is never read at runtime (there is
# no `.env` loader; see the note at the top of this file). It exists so an
# owner can see every variable CausalOps touches and its default in one
# place; the value below is illustrative, not a config file CausalOps
# consults. Export the real value into your shell before running.
#
# Application-wide ceiling on authorizing new live Claude spend, covering
# every standalone `investigate --model claude` run and the paired
# evaluation together (README.md's "Budgets" section) -- not a per-run cap.
# Before every live request, the cost gate reserves a conservative estimate
# against this ceiling and refuses to send if it would exceed what remains;
# the reservation settles against the provider's real reported usage once
# the request completes. Absent or blank falls back to the 5.00 default
# shown here.
#
# `causalops-evaluate`'s 12-incident, three-evidence-budget-curve design
# (README.md's "Paired live evaluation" section) needs more headroom than
# the 5.00 default: each of the three `--executed-tools` invocations runs
# 24 real, billed requests-worth of runs at its own budget point. An owner
# running the full curve should `export LIVE_EVALUATION_MAX_USD=13.00` (or
# higher) in their shell first -- `causalops-evaluate`'s own pre-flight
# check refuses cleanly, before any scenario starts, if the configured
# ceiling could not possibly cover one invocation's worst-case batch cost.
#
# A configured value that leaves no room for even the cheapest possible
# request is refused outright at startup (FAIL
# CEILING_BELOW_RESERVATION_BUFFER), rather than accepted and then silently
# refusing every single reservation -- see `cost_ledger.py`'s
# `RESERVATION_CEILING_BUFFER_USD`/`live_setup.py`'s
# `MINIMUM_USABLE_CEILING_USD` for the exact current floor. A value that
# can't be parsed as a finite positive number (unparseable text, "inf",
# "nan") is refused the same way (FAIL CEILING_MALFORMED). Set this
# comfortably above that floor.
LIVE_EVALUATION_MAX_USD=5.00

# langchain-core and langgraph can send traces to LangSmith, a third-party
# service. CausalOps forces both of these off unconditionally at package
# import time (see src/causalops/__init__.py) -- LangSmith tracing is
# prohibited outright, so this is not a default you can opt back into by
# setting these to "true". They are listed here only so every variable
# CausalOps touches is documented in one place. Leave LANGSMITH_API_KEY /
# LANGCHAIN_API_KEY unset.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
