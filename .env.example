# These are the environment variables CausalOps reads. There is no `.env`
# loader in this project (no python-dotenv), so export them into your shell
# before running `causalops` -- e.g. `set -a; source .env; set +a`. Never
# commit real secrets.

# Required only for a live run (`causalops investigate --model claude`,
# Unit 3b-2's adapter -- see TECHNICAL_SPEC.md). Absent or empty, causalops
# runs entirely on replay fixtures and the local synthetic lab; `causalops
# doctor` warns but does not fail if this is unset, since a replay run never
# needs it.
ANTHROPIC_API_KEY=

# Unit 3b-2. Application-wide ceiling on AUTHORIZING new live Claude spend,
# covering every standalone `investigate --model claude` run and the paired
# evaluation together (TECHNICAL_SPEC.md section 10) -- not a per-run cap.
# Before every live request, the cost gate persists a conservative
# reservation and refuses to send if it would exceed what remains of this
# ceiling. Absent or blank falls back to the default shown here. Unit 3b-3
# raised that default from 2.00 to 5.00, re-derived from the owner's first
# live run: `pricing.py`'s ratio replan roughly triples the reservation's
# input-token component (2.97x, 5,780 to 17,195 tokens worst case), but the
# fixed $0.016 output allowance dominates every reservation, so the
# worst-case DOLLAR reservation only moves ~1.8x ($0.02756 to $0.05039;
# ~1.54x for the smoke call's own turn shape). 5.00 keeps the same "six
# held-out pairs plus room for reruns" headroom TECHNICAL_SPEC.md section 10
# describes, re-derived against the larger reservation rather than the
# multiplier alone.
#
# This is honestly not an absolute guarantee on the real dollar total, the
# same way `pricing.py`'s PESSIMISTIC_CHARS_PER_TOKEN is a deliberately
# conservative empirical estimate rather than a universal tokenizer
# guarantee: the real cost of a request is only known after it settles, so
# a single request that bills above its own conservative reservation can
# push cumulative spend transiently past this figure -- by at most that one
# request's worst-case estimation error -- before the NEXT reservation
# check reflects it (cost_ledger.py's `_reserved_and_settled_total` counts
# a settled row at its true cost from that point forward, so the overrun
# cannot silently repeat, but it cannot un-happen for the request that
# caused it). What this ceiling actually bounds is the system's
# authorization behavior -- refusing to authorize a NEW reservation once
# known spend would exceed it -- not the provider's real bill.
#
# Later addendum: the gate stops authorizing new reservations a fixed $0.10
# short of this figure, not at it (cost_ledger.py's
# RESERVATION_CEILING_BUFFER_USD, sized against this project's own observed
# live-call costs -- see that constant's own comment for the figures it is
# derived from). This narrows, but does not close, the transient-overrun
# gap described above -- a reserved margin, not a guarantee that real spend
# can never cross LIVE_EVALUATION_MAX_USD.
#
# A ceiling only just above that $0.10 buffer is still unusable -- the
# Values at or below the fixed $0.10 buffer are refused outright at startup
# (FAIL CEILING_BELOW_RESERVATION_BUFFER). A value above that structural
# floor can still be refused by the exact request-time reservation check,
# because the request's size is incident- and stage-dependent. A value
# that cannot even be parsed as a finite positive number -- unparseable
# text, "inf", or "nan" -- is also refused outright now (FAIL
# CEILING_MALFORMED) rather than silently falling back to the 5.00 default
# above, which would authorize far MORE spend than a fat-fingered value
# suggested was intended. Only an absent or blank value still falls back to
# that default. Set this above $0.10 with headroom for real requests. Full design
# rationale is in TECHNICAL_OVERVIEW.md's "Live-evaluation cost ceiling
# validation" section.
LIVE_EVALUATION_MAX_USD=5.00

# langchain-core and langgraph (Unit 1a's dependencies) can send traces to
# LangSmith, a third-party service. CausalOps forces both of these off
# unconditionally at package import time (see src/causalops/__init__.py) --
# TECHNICAL_SPEC.md section 11 prohibits LangSmith tracing outright, so this
# is not a default you can opt back into by setting these to "true". They
# are listed here only so every variable CausalOps touches is documented in
# one place. Leave LANGSMITH_API_KEY / LANGCHAIN_API_KEY unset.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
